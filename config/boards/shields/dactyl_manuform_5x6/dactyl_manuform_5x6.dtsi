#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &dactyl_5x6_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <6>;
// | MX1  | MX2  | MX3  | MX4  | MX5  | MX6  |                 | MX7  | MX8  | MX9  | MX10 | MX11 | MX12 |
// | MX13 | MX14 | MX15 | MX16 | MX17 | MX18 |                 | MX19 | MX20 | MX21 | MX22 | MX23 | MX24 |
// | MX25 | MX26 | MX27 | MX28 | MX29 | MX30 |                 | MX31 | MX32 | MX33 | MX34 | MX35 | MX36 |
// | MX37 | MX38 | MX39 | MX40 | MX41 | MX42 |                 | MX43 | MX44 | MX45 | MX46 | MX47 | MX48 |
//               | MX49 | MX50 | MX51 | MX52 |                 | MX53 | MX54 | MX55 | MX56 |
//               | MX57 | MX58 | MX59 | MX60 |                 | MX61 | MX62 | MX63 | MX64 |
// Right-hand row4 reuses RC(3,9)/RC(3,8) (row3's wiring) instead of RC(4,9)/RC(4,8) -
// intentional per hand-wiring; those 2 thumb keys will always mirror the K/L keys.
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                   RC(0,11) RC(0,10) RC(0,9) RC(0,8) RC(0,7) RC(0,6)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                   RC(1,11) RC(1,10) RC(1,9) RC(1,8) RC(1,7) RC(1,6)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)                   RC(2,11) RC(2,10) RC(2,9) RC(2,8) RC(2,7) RC(2,6)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)                   RC(3,11) RC(3,10) RC(3,9) RC(3,8) RC(3,7) RC(3,6)
        RC(4,2) RC(4,3) RC(4,4) RC(4,5)                           RC(4,11) RC(4,10) RC(3,9) RC(3,8)
        RC(5,2) RC(5,3) RC(5,4) RC(5,5)                           RC(5,11) RC(5,10) RC(5,9) RC(5,8)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        wakeup-source;
        diode-direction = "col2row";
        row-gpios
            = <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

    };

    dactyl_5x6_layout: dactyl_5x6_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys  //                     w    h     x     y     r    rx    ry
            /* Row 0 */
            = <&key_physical_attrs  100  100     0    40     0     0    40>
            , <&key_physical_attrs  100  100   100    20     0   100    20>
            , <&key_physical_attrs  100  100   200     5     0   200     5>
            , <&key_physical_attrs  100  100   300    20     0   300    20>
            , <&key_physical_attrs  100  100   400    40     0   400    40>
            , <&key_physical_attrs  100  100   500    55     0   500    55>
            , <&key_physical_attrs  100  100   700    55     0   700    55>
            , <&key_physical_attrs  100  100   800    40     0   800    40>
            , <&key_physical_attrs  100  100   900    20     0   900    20>
            , <&key_physical_attrs  100  100  1000     5     0  1000     5>
            , <&key_physical_attrs  100  100  1100    20     0  1100    20>
            , <&key_physical_attrs  100  100  1200    40     0  1200    40>
            /* Row 1 */
            , <&key_physical_attrs  100  100     0   140     0     0   140>
            , <&key_physical_attrs  100  100   100   120     0   100   120>
            , <&key_physical_attrs  100  100   200   105     0   200   105>
            , <&key_physical_attrs  100  100   300   120     0   300   120>
            , <&key_physical_attrs  100  100   400   140     0   400   140>
            , <&key_physical_attrs  100  100   500   155     0   500   155>
            , <&key_physical_attrs  100  100   700   155     0   700   155>
            , <&key_physical_attrs  100  100   800   140     0   800   140>
            , <&key_physical_attrs  100  100   900   120     0   900   120>
            , <&key_physical_attrs  100  100  1000   105     0  1000   105>
            , <&key_physical_attrs  100  100  1100   120     0  1100   120>
            , <&key_physical_attrs  100  100  1200   140     0  1200   140>
            /* Row 2 */
            , <&key_physical_attrs  100  100     0   240     0     0   240>
            , <&key_physical_attrs  100  100   100   220     0   100   220>
            , <&key_physical_attrs  100  100   200   205     0   200   205>
            , <&key_physical_attrs  100  100   300   220     0   300   220>
            , <&key_physical_attrs  100  100   400   240     0   400   240>
            , <&key_physical_attrs  100  100   500   255     0   500   255>
            , <&key_physical_attrs  100  100   700   255     0   700   255>
            , <&key_physical_attrs  100  100   800   240     0   800   240>
            , <&key_physical_attrs  100  100   900   220     0   900   220>
            , <&key_physical_attrs  100  100  1000   205     0  1000   205>
            , <&key_physical_attrs  100  100  1100   220     0  1100   220>
            , <&key_physical_attrs  100  100  1200   240     0  1200   240>
            /* Row 3 */
            , <&key_physical_attrs  100  100     0   340     0     0   340>
            , <&key_physical_attrs  100  100   100   320     0   100   320>
            , <&key_physical_attrs  100  100   200   305     0   200   305>
            , <&key_physical_attrs  100  100   300   320     0   300   320>
            , <&key_physical_attrs  100  100   400   340     0   400   340>
            , <&key_physical_attrs  100  100   500   355     0   500   355>
            , <&key_physical_attrs  100  100   700   355     0   700   355>
            , <&key_physical_attrs  100  100   800   340     0   800   340>
            , <&key_physical_attrs  100  100   900   320     0   900   320>
            , <&key_physical_attrs  100  100  1000   305     0  1000   305>
            , <&key_physical_attrs  100  100  1100   320     0  1100   320>
            , <&key_physical_attrs  100  100  1200   340     0  1200   340>
            /* Thumb row 0 */
            , <&key_physical_attrs  100  100   200   510 -1200   200   510>
            , <&key_physical_attrs  100  100   300   490  -400   300   490>
            , <&key_physical_attrs  100  100   400   480   400   400   480>
            , <&key_physical_attrs  100  100   500   505  1200   500   505>
            , <&key_physical_attrs  100  100   700   505 -1200   700   505>
            , <&key_physical_attrs  100  100   800   480  -400   800   480>
            , <&key_physical_attrs  100  100   900   490   400   900   490>
            , <&key_physical_attrs  100  100  1000   510  1200  1000   510>
            /* Thumb row 1 */
            , <&key_physical_attrs  100  100   200   620 -1200   200   620>
            , <&key_physical_attrs  100  100   300   600  -400   300   600>
            , <&key_physical_attrs  100  100   400   590   400   400   590>
            , <&key_physical_attrs  100  100   500   615  1200   500   615>
            , <&key_physical_attrs  100  100   700   615 -1200   700   615>
            , <&key_physical_attrs  100  100   800   590  -400   800   590>
            , <&key_physical_attrs  100  100   900   600   400   900   600>
            , <&key_physical_attrs  100  100  1000   620  1200  1000   620>
            ;
    };
};
